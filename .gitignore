venv/
env/

# Frappe / ERPNext
*.log
logs/
sites/
env/
config/
assets/
node_modules/
*.pyc

# 数据库备份（含敏感数据）
*.sql
*.sql.gz
*.tgz
backup/
backups/

# 密钥与凭据（绝对不能提交）
.env
.env.*
*.pem
*.key
secrets/
credentials.json
id_rsa*

# 上传文件与图片
*.png
*.jpg
*.jpeg
*.gif
*.webp
!docs/**/*.png
!docs/**/*.jpg

# 编辑器
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# 临时文件
*.bak
*.bak-*
*.orig
*.tmp
nohup.out

# macOS 残留文件（会被 tar 带进服务器，污染 esbuild 构建）
._*
.DS_Store

# 编译产物（bench build 生成，不入库）
*.mo
node_modules/
sites/assets/
